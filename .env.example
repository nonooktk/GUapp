# 環境変数のサンプル（設計仕様書 8.2）。値はすべて空。
# 使い方: このファイルを apps/api/.env と apps/web/.env にコピーして値を埋める。
# .env はコミット禁止（.gitignore と pre-commit で二重に拒否する）。

# ── apps/api（FastAPI）──
# 実行環境: development | test | production（production では /docs を無効化）
APP_ENV=
# MySQL 接続文字列（SQLAlchemy URL。スキーム mysql+asyncmy、ホスト 127.0.0.1、ポート 3306、DB 名 guapp。ユーザー名とパスワードは URL に埋め込む）
DATABASE_URL=
# BFF → FastAPI の内部認証トークン（web と同じ値を設定。DS-DEC-27）
INTERNAL_TOKEN=
# 許可オリジン（BFF の URL。1 つだけ）
CORS_ALLOW_ORIGIN=
# 決済スタブの結果: ok | ng（P1 のみ。P2 以降の本番では未設定＝スタブ OFF。DS-DEC-26）
PAYMENT_STUB_RESULT=

# ── apps/web（Next.js）──
# 実行環境: development | test | production（production のときだけ Cookie に Secure を付ける）
APP_ENV=
# FastAPI の URL（サーバー側のみで使う。NEXT_PUBLIC_ を付けない）
API_BASE_URL=
# BFF → FastAPI の内部認証トークン（api と同じ値）
INTERNAL_TOKEN=
# 商品画像の配信ベース URL（DS-DEC-22）
IMAGE_BASE_URL=
# Cookie のドメイン（ローカルは空）
SESSION_COOKIE_DOMAIN=
