# 環境変数のサンプル（設計仕様書 8.2）。値はすべて空。
# 使い方: このファイルを apps/api/.env と apps/web/.env にコピーして値を埋める。
# .env はコミット禁止（.gitignore と pre-commit で二重に拒否する）。

# ── apps/api（FastAPI）──
# 実行環境: development | test | production（production では /docs を無効化）
APP_ENV=
# MySQL 接続文字列（SQLAlchemy URL。スキーム mysql+asyncmy、ホスト 127.0.0.1、ポート 3306、DB 名 guapp。ユーザー名とパスワードは URL に埋め込む）
DATABASE_URL=
# 結合テスト用（DB 名は必ず _test で終える。conftest が開発 DB を守るために検査する。.env ではなく環境変数で渡す）
DATABASE_URL_TEST=
# BFF → FastAPI の内部認証トークン（web と同じ値を設定。DS-DEC-27）
INTERNAL_TOKEN=
# 許可オリジン（BFF の URL。1 つだけ）
CORS_ALLOW_ORIGIN=
# 決済スタブの結果: ok | ng（P1 のみ。P2 以降の本番では未設定＝スタブ OFF。DS-DEC-26）
PAYMENT_STUB_RESULT=

# ── apps/web（Next.js）──
# 実行環境: development | test | production（production のときだけ Cookie に Secure を付ける）
APP_ENV=
# FastAPI の URL（サーバー側のみで使う。NEXT_PUBLIC_ を付けない）
API_BASE_URL=
# BFF → FastAPI の内部認証トークン（api と同じ値）
INTERNAL_TOKEN=
# 商品画像の配信ベース URL（DS-DEC-22）
IMAGE_BASE_URL=
# Cookie のドメイン（ローカルは空）
SESSION_COOKIE_DOMAIN=
# 信頼するプロキシのホップ数（ローカルは空=0。App Service 配下は 1）。利用者送信の X-Forwarded-For／X-Client-IP は信用しない
TRUSTED_PROXY_HOPS=

# --- api: 会員・管理画面（P2-b・P2-c） ---
# 会員登録のメールにあるリンクの宛先。例: http://127.0.0.1:3000
PUBLIC_WEB_BASE_URL=
# 確認メールなしで登録できるデモ用ドメイン（カンマ区切り）。例: example.com
DEMO_EMAIL_DOMAINS=
# seed の実行時だけ使う。アプリ設定には残さない
SEED_MEMBER_PASSWORD=
SEED_STAFF_PASSWORD=
# 空なら demo-staff
SEED_STAFF_LOGIN_ID=

# --- api: AI アシスタント（P2-d） ---
OPENAI_API_KEY=
# 空なら gpt-6-luna
OPENAI_MODEL=
# auto / openai / stub。空なら auto（キーがあれば openai）
LLM_PROVIDER=
# 空なら true
CHAT_ENABLED=
# 空なら 1 日 300 回、IP ごとに 1 時間 30 回、会話は 10 往復まで
CHAT_DAILY_LIMIT=
CHAT_IP_LIMIT_PER_HOUR=
CHAT_TURN_LIMIT=

# --- web: 回数制限 ---
# 空なら /api は 1 分 120 回、ページは 1 分 600 回（IP ごと）
RATE_LIMIT_API_PER_MIN=
RATE_LIMIT_PAGE_PER_MIN=
