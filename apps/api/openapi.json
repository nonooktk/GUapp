  "components": {
    "schemas": {
      "CartItemIn": {
        "properties": {
          "variant_id": {
            "type": "integer",
            "title": "Variant Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "variant_id",
          "quantity"
        ],
        "title": "CartItemIn",
        "description": "POST /cart/items。上限（10・50）は業務規則なのでここには書かない（422 で返す）。"
      },
      "CartItemPatchIn": {
        "properties": {
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "quantity"
        ],
        "title": "CartItemPatchIn",
        "description": "PATCH /cart/items/{item_id}。"
      },
      "CartLineOut": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "variant_id": {
            "type": "integer",
            "title": "Variant Id"
          },
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "unit_price": {
            "type": "integer",
            "title": "Unit Price"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "line_total": {
            "type": "integer",
            "title": "Line Total"
          },
          "stock_status": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient",
              "out_of_stock"
            ],
            "title": "Stock Status"
          },
          "image_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Path"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "variant_id",
          "product_id",
          "product_name",
          "color",
          "size",
          "unit_price",
          "quantity",
          "line_total",
          "stock_status",
          "image_path"
        ],
        "title": "CartLineOut"
      },
      "CartResponse": {
        "properties": {
          "cart_token": {
            "type": "string",
            "title": "Cart Token"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartLineOut"
            },
            "type": "array",
            "title": "Items"
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count",
            "description": "数量の合計"
          },
          "subtotal": {
            "type": "integer",
            "title": "Subtotal"
          },
          "shipping_fee": {
            "type": "integer",
            "title": "Shipping Fee"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "free_shipping_threshold": {
            "type": "integer",
            "title": "Free Shipping Threshold"
          },
          "can_checkout": {
            "type": "boolean",
            "title": "Can Checkout",
            "description": "明細 1 件以上かつ全明細が ok"
          }
        },
        "type": "object",
        "required": [
          "cart_token",
          "items",
          "item_count",
          "subtotal",
          "shipping_fee",
          "total",
          "free_shipping_threshold",
          "can_checkout"
        ],
        "title": "CartResponse"
      },
      "CategoriesResponse": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryOut"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "categories"
        ],
        "title": "CategoriesResponse"
      },
      "CategoryChildOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "product_count": {
            "type": "integer",
            "title": "Product Count",
            "description": "公開商品の件数"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "product_count"
        ],
        "title": "CategoryChildOut"
      },
      "CategoryOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "gender": {
            "type": "string",
            "enum": [
